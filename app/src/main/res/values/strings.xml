    <string name="about_author_section">Author</string>
    <string name="about_author_name">@kongdayan</string>
    <string name="about_author_role">Independent developer</string>
    <string name="about_author_bio">I build small, focused tools that respect privacy and work offline. Magazine Library is one of them.</string>
