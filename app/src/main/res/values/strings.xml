    <string name="about_privacy_section">Privacy</string>
    <string name="about_privacy">No analytics, no tracking, no accounts. Cookies, reading progress and downloads stay on this device. The app talks only to the magazine website and, when you ask, to GitHub for release information.</string>
    <string name="about_disclaimer_section">Disclaimer</string>
    <string name="about_disclaimer">Magazine Library is an independent, unofficial client for magazinelib.com and is not affiliated with that site. Downloaded files are subject to the source site’s terms and to copyright law. Use it only for content you may legally access.</string>
    <string name="about_credits_section">Built with</string>
    <string name="about_credits">Android platform, system WebView and PdfRenderer. No third-party runtime libraries, no ads and no telemetry.</string>
